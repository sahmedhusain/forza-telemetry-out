{
  "name": "forza-telemetry-out",
  "version": "1.6.1",
  "description": "Independent Forza Horizon 6 telemetry cockpit for desktop and browser",
  "main": "main.js",
  "scripts": {
    "start": "node server/index.js",
    "web": "node server/index.js",
    "electron": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sahmedhusain/forza-telemetry-out.git"
  },
  "keywords": [
    "forza",
    "forza-horizon",
    "forza-motorsport",
    "telemetry",
    "sim-racing",
    "dashboard",
    "electron",
    "udp",
    "racing-hud",
    "canbus",
    "g-force"
  ],
  "author": "sahmedhusain",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "io.github.sahmedhusain.forzatelemetry",
    "productName": "Forza Telemetry Out",
    "files": [
      "main.js",
      "preload.js",
      "server/**",
      "public/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "public/assets/app-icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/assets/app-icon.ico",
      "signExecutable": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/assets/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Forza-Telemetry-Out-${version}-Windows-${arch}-Setup.${ext}"
    },
    "artifactName": "Forza-Telemetry-Out-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "Forza-Telemetry-Out-${version}-Windows-${arch}-Portable.${ext}"
    }
  }
}
