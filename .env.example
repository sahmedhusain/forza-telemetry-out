# ==============================================================================
# FORZA TELEMETRY OUT - CONFIGURATION
# ==============================================================================
# Set your local network, UDP, and web server preferences below.

# --- UDP Telemetry Listener ---
# UDP port where Forza Motorsport / Forza Horizon streams telemetry packets
# (Must match the 'Data Out IP Port' setting in Forza game options)
FORZA_PORT=5300

# Network interface IP to bind the UDP socket (0.0.0.0 listens on all interfaces)
FORZA_HOST=0.0.0.0

# --- Web Dashboard & WebSocket Server ---
# HTTP web server port for the dashboard UI and WebSocket real-time feed
WEB_PORT=3050

# Hostname / IP address for the web server to bind
WEB_HOST=0.0.0.0

# --- Telemetry Engine Settings ---
# Target WebSocket broadcast frequency in Hertz (typically 60 to match game physics)
BROADCAST_RATE_HZ=60

# Default telemetry measurement units ('metric' for km/h, °C, Bar, kW | 'imperial' for mph, °F, PSI, HP)
DEFAULT_UNITS=metric

# Auto-start simulation mode when the server launches if no live game stream is detected
SIMULATION_MODE=false

# Auto-record session on race start (saves telemetry traces into /recordings)
AUTO_RECORD=false

# Logging verbosity level (trace | debug | info | warn | error)
LOG_LEVEL=info
