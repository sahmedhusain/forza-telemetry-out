# Copy to .env. No credentials or cloud services are required.
# Match this port in FH6 > Settings > HUD and Gameplay > Data Out IP Port.
# Do not use 5200–5300 (reserved by the game).
FORZA_PORT=5500
# 0.0.0.0 receives UDP from your console/PC on your local network.
FORZA_HOST=0.0.0.0
WEB_PORT=3050
# Local browser only by default. Use 0.0.0.0 only on a trusted private LAN.
WEB_HOST=127.0.0.1

# Optional absolute directory for saved per-car history.
# Default: repository data/ (source), Electron user-data/data/ (installed).
# FORZA_DATA_DIR=/absolute/path/to/telemetry-data
